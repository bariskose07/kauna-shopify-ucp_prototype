# ─────────────────────────────────────────────────────────────────────────────
# Kauna × Shopify UCP prototype — environment variables
# Copy to .env (or .env.local) and fill in. .env is git-ignored.
# Every variable is read on the SERVER only (no NEXT_PUBLIC_ prefix anywhere).
# ─────────────────────────────────────────────────────────────────────────────

# Shopify Dev Dashboard → client credentials (Authenticate your agent, step 1).
# The server exchanges them at https://api.shopify.com/auth/access_token
# (grant_type=client_credentials), keeps the JWT in memory and refreshes it
# 1 minute before `exp`. The token is sent ONLY to:
#   - the Global Catalog (search_catalog / lookup_catalog / get_product)
#   - checkout tools (create / get / update / cancel_checkout)
# Merchant catalog and cart tools never get it (by design).
# Without these, Global Catalog and checkout calls are NOT sent (no silent
# anonymous fallback) and the UI shows "Token alınamadı: …".
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional own agent profile for cart + checkout calls. Used only if it
# declares dev.ucp.shopping.cart, .checkout AND .fulfillment (without
# fulfillment the merchant offers no shipping-address field); otherwise
# https://shopify.dev/ucp/agent-profiles/2026-08-25/valid-with-capabilities.json
# Catalog calls always use .../examples/2026-08-25/valid-with-capabilities.json
UCP_AGENT_PROFILE_URL=

# Buyer's public IP for the `Shopify-Buyer-IP` header that Shopify requires on
# token-authenticated checkout calls (else: 422 "Missing required buyer IP
# header."). In production the incoming request's public IP is used; locally
# (localhost / Wi-Fi addresses are private) set your Mac's public IP:
#   curl -s https://api.ipify.org
UCP_BUYER_IP=

# TEST ONLY — both default off, also switchable in Ayarlar → "Kimlik (yalnızca test)".
# 1 = when the token is missing/rejected, retry once WITHOUT it (marked
#     "token yok – yedek" everywhere).
UCP_TOKENLESS_FALLBACK=0
# cli = route every call through @shopify/ucp-cli (marked "CLI (test)").
UCP_TRANSPORT=auto
# Path to the ucp binary for the CLI adapter (default: `ucp` on PATH).
UCP_CLI_BIN=ucp

# Dev Dashboard → Catalog: MCP endpoint + catalog id.
# SHOPIFY_CATALOG_URL is used as-is. SHOPIFY_CATALOG_ID is sent as
# `catalog.catalog_id` on Global Catalog search.
SHOPIFY_CATALOG_URL=https://catalog.shopify.com/api/ucp/mcp
SHOPIFY_CATALOG_ID=

# Fallback when SHOPIFY_CATALOG_URL is empty: Global Catalog business URL,
# discovered via <url>/.well-known/ucp.
UCP_CATALOG_URL=https://catalog.shopify.com

# Default seller shown in the UI (the "seller domain + product" lookup box).
DEFAULT_SELLER=https://us.aabcollection.com

# Max seconds we are willing to wait for a single 429 Retry-After before
# surfacing the rate-limit to the UI instead.
UCP_MAX_RETRY_AFTER_SECONDS=5
