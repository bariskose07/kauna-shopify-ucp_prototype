# ─────────────────────────────────────────────────────────────────────────────
# Kauna × Shopify UCP prototype — environment variables
# Copy to .env (or .env.local) and fill in. .env is git-ignored.
# Every variable is read on the SERVER only (no NEXT_PUBLIC_ prefix anywhere).
# ─────────────────────────────────────────────────────────────────────────────

# Optional. Shopify Dev Dashboard → Catalog → client credentials.
# When BOTH are set the server exchanges them at
# https://api.shopify.com/auth/access_token (grant_type=client_credentials),
# caches the token in memory (~60 min) and sends `Authorization: Bearer <token>`
# on every UCP JSON-RPC request. When empty, the server behaves exactly like
# @shopify/ucp-cli: unauthenticated requests identified only by the agent
# profile URL below.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Agent (platform) profile URL sent in every request as meta["ucp-agent"].profile.
# Businesses fetch this URL to negotiate capabilities. Leave empty to pick
# Shopify's sample profile for the UCP version the business supports
# (https://shopify.dev/ucp/agent-profiles/<version>/valid-with-capabilities.json).
UCP_AGENT_PROFILE_URL=

# Transport: "auto" (default: direct JSON-RPC, bearer token when credentials exist)
# or "cli" (spawn `ucp ... --format json` from @shopify/ucp-cli via child_process).
UCP_TRANSPORT=auto
# Path to the ucp binary for UCP_TRANSPORT=cli (default: `ucp` on PATH).
UCP_CLI_BIN=ucp

# Global Catalog business URL (discovered via <url>/.well-known/ucp).
UCP_CATALOG_URL=https://catalog.shopify.com

# Default seller shown in the UI (the "seller domain + product" lookup box).
DEFAULT_SELLER=https://us.aabcollection.com

# Max seconds we are willing to wait for a single 429 Retry-After before
# surfacing the rate-limit to the UI instead.
UCP_MAX_RETRY_AFTER_SECONDS=5
